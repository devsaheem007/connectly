# ───────────────────────────────────────────────────────────
#  Connectly — server environment
#  Copy this file to ".env" (same folder) and fill in the values.
# ───────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────
PORT=5000
# Local MongoDB:      mongodb://127.0.0.1:27017/connectly
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connectly?retryWrites=true&w=majority
MONGO_URI=
# A long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# URL(s) where the React app runs. Comma-separate several.
CLIENT_URL=http://localhost:5173

# ── Sessions / cookies ─────────────────────────────────────
JWT_EXPIRES_DAYS=7
# Same-site deploy (or localhost): leave as "lax".
# Client and API on DIFFERENT domains in production: set to "none" (needs HTTPS).
COOKIE_SAMESITE=lax
# true forces the Secure flag. It is automatic when NODE_ENV=production or SAMESITE=none.
# COOKIE_SECURE=

# ── Email (OTP codes + password reset) ─────────────────────
# Leave empty during development: codes/links are printed in the server console
# and shown on screen. Fill in for real emails (Gmail example below).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail use an "App password" (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=
EMAIL_FROM=Connectly <no-reply@yourdomain.com>

# ── Cloudinary (file + image uploads) ──────────────────────
# Leave empty to store uploads on the server's disk (server/uploads) — fine for development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google sign-in ("Continue with Google") ────────────────
# OAuth 2.0 Web client ID from Google Cloud Console. Add your client URL under
# "Authorized JavaScript origins" (e.g. http://localhost:5173).
GOOGLE_CLIENT_ID=

# ── Misc ───────────────────────────────────────────────────
# Shows a "Try the demo account" button (needs `npm run seed`). Defaults to true in development only.
ALLOW_DEMO_LOGIN=false
# true = this server also serves the built React app from ../client/dist (single-host deploy)
SERVE_CLIENT=false
# Password for the seeded admin account (default Admin@12345)
# SEED_ADMIN_PASSWORD=
# NODE_ENV=production
